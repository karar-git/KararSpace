// Prisma schema for Portfolio
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Admin user for dashboard
model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Projects
model Project {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  shortDescription String?
  problem          String?
  approach         String?
  insights         String?
  mainImage        String?
  projectUrl       String?
  githubUrl        String?
  tags             String[] @default([])
  featured         Boolean  @default(false)
  published        Boolean  @default(false)
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Articles / Writing
model Article {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  summary         String?
  content         String?
  featuredImage   String?
  readingTime     Int?
  tags            String[]  @default([])
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Certificates
model Certificate {
  id             String    @id @default(cuid())
  title          String
  issuer         String?
  credentialId   String?
  credentialLink String?
  issueDate      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Research Papers
model Research {
  id                String    @id @default(cuid())
  title             String
  slug              String    @unique
  abstract          String?
  authors           String?
  journalConference String?
  paperUrl          String?
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Ideas / Quick Notes
model Idea {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Life Content (Personal Blog)
model LifeContent {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String?
  coverImage  String?
  readingTime Int?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Now Focus (What I'm doing now)
model NowFocus {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String?  @default("active")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Opportunities (shared opportunities for students/developers)
model Opportunity {
  id          String    @id @default(cuid())
  title       String
  description String?
  link        String?
  type        String?   // e.g., "internship", "scholarship", "competition", "program"
  deadline    DateTime?
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Site Settings (personal info, social links, etc.)
model SiteSettings {
  id          String   @id @default("main")
  name        String?
  title       String?
  bio         String?
  email       String?
  location    String?
  avatarUrl   String?
  cvUrl       String?
  socialLinks Json?    @default("[]")
  interests   Json?    @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Email Subscribers
model Subscriber {
  id           String    @id @default(cuid())
  email        String    @unique
  verified     Boolean   @default(false)
  subscribedAt DateTime  @default(now())
  unsubscribedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ============ private: /my_little_dndn ============

// A list of notes — "the date list" is the first one, either of them can add more
model NoteList {
  id        String   @id @default(cuid())
  name      String
  // Order of the chips. Defaults keep this additive; boot fills real values in.
  position  Int      @default(0)
  // How the list looks: deck | someday | places | ritual | dates. Null means
  // "guess from the name", so nothing has to be written for old lists.
  theme     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notes     Note[]
}

// A note on a shared list — something to talk about on the next date
model Note {
  id        String    @id @default(cuid())
  body      String
  author    String    @default("us") // kept for old rows; notes are not attributed
  photoUrl  String?
  spinLabel String? // short two-line label for the wheel
  done      Boolean   @default(false)
  doneAt    DateTime?
  // Nullable on purpose: adding it this way cannot drop the notes already here.
  // Anything still null is adopted by the first list on boot.
  listId    String?
  list      NoteList? @relation(fields: [listId], references: [id])
  // Order within its list, top first. Backfilled from createdAt on boot.
  position  Int       @default(0)
  // Where the pin sits on the drawn map (places lists), as 0..1 fractions
  mapX      Float?
  mapY      Float?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([listId])
}

// Photos live here rather than in a third-party bucket — it is a handful of
// images between two people, and the id is what keeps them unlisted
model UsPhoto {
  id        String   @id
  mime      String
  bytes     Bytes
  createdAt DateTime @default(now())
}

// Settings for the private page (the two names, anniversary, next date)
model CoupleSettings {
  id                String    @id @default("main")
  nameOne           String?
  nameTwo           String?
  anniversary       DateTime?
  nextDate          String?
  // The shared password, once it has been changed from the page. Until then
  // the COUPLE_PASSWORD env var is what counts. Nullable, so adding it is free.
  passwordHash      String?
  passwordChangedAt DateTime?
  // How photos open (stack | film | polaroids) and how dates are shown
  // (thread | book | calendar). Nullable, so adding them is free.
  photoViewer       String?
  dateView          String?
  updatedAt         DateTime  @updatedAt
}

// One date we went on. Numbers are not stored: they follow position, and a
// date with numbered = false shows a question mark until it is placed.
model UsDate {
  id           String         @id @default(cuid())
  place        String
  date         DateTime?
  position     Int            @default(0) // top of the thread first
  numbered     Boolean        @default(true)
  // The note it was copied from, so an import never makes the same date twice
  sourceNoteId String?        @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  photos       UsDatePhoto[]
  notes        UsDateNote[]
  ratings      UsDateRating[]
}

model UsDatePhoto {
  id        String   @id @default(cuid())
  dateId    String
  date      UsDate   @relation(fields: [dateId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  position  Int      @default(0) // the first one is the cover
  createdAt DateTime @default(now())

  @@index([dateId])
}

// One note per person per date
model UsDateNote {
  id        String   @id @default(cuid())
  dateId    String
  date      UsDate   @relation(fields: [dateId], references: [id], onDelete: Cascade)
  author    String // 'karar' | 'dania'
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dateId, author])
}

model UsDateRating {
  id        String   @id @default(cuid())
  dateId    String
  date      UsDate   @relation(fields: [dateId], references: [id], onDelete: Cascade)
  author    String // 'karar' | 'dania'
  category  String // 'fun' | 'romantic' | 'food' | 'place'
  score     Int // 1..5
  updatedAt DateTime @updatedAt

  @@unique([dateId, author, category])
}

// The preview image of a saved Instagram link. Instagram's own image links
// expire, so the bytes are kept here the first time a note needs them.
model UsLinkThumb {
  key       String   @id // "ig:<shortcode>"
  mime      String
  bytes     Bytes
  createdAt DateTime @default(now())
}
