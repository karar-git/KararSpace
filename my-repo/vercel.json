{
  "build": {
    "env": {
      "PUBLIC_API_URL": "https://kararspace-production.up.railway.app/api"
    }
  },
  "rewrites": [
    {
      "source": "/cv",
      "destination": "https://kararspace-production.up.railway.app/api/cv"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    }
  ]
}
